{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "region.schema.json",
  "title": "Leagues region guide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "region",
    "locations",
    "bosses",
    "features",
    "pvmUpgrades",
    "utilityUpgrades",
    "abilities"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "region": { "type": "string", "minLength": 1 },
    "locations": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" }
    },
    "bosses": {
      "type": "array",
      "items": { "$ref": "#/$defs/boss" }
    },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" }
    },
    "pvmUpgrades": {
      "type": "array",
      "items": { "$ref": "#/$defs/pvmGroup" }
    },
    "utilityUpgrades": {
      "type": "array",
      "items": { "$ref": "#/$defs/utilityGroup" }
    },
    "abilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/abilityGroup" }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "boss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "children"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        }
      }
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          { "$ref": "#/$defs/link" },
          {
            "type": "object",
            "properties": {
              "note": { "type": "string" },
              "alsoAvailableIn": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/regionSlug" }
              }
            }
          }
        ]
      }
    },
    "regionSlug": {
      "type": "string",
      "enum": [
        "starting-regions",
        "anachronia",
        "asgarnia",
        "fremennik",
        "kandarin",
        "desert",
        "morytania",
        "tirannwn",
        "wilderness",
        "karamja"
      ]
    },
    "pvmGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "rows"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/pvmRow" }
        }
      }
    },
    "pvmRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "style", "items"],
      "properties": {
        "tier": { "type": "string" },
        "style": { "type": "string" },
        "items": { "$ref": "#/$defs/items" }
      }
    },
    "utilityGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "rows"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/utilityRow" }
        }
      }
    },
    "utilityRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "type": "string" },
        "items": { "$ref": "#/$defs/items" }
      }
    },
    "abilityGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "rows"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/abilityRow" }
        }
      }
    },
    "abilityRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "style", "items"],
      "properties": {
        "level": { "type": "string" },
        "style": { "type": "string" },
        "items": { "$ref": "#/$defs/items" }
      }
    }
  }
}
